@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Settings backdrop: deep night blue with a soft light from the top left, so the glass rows have something to catch. -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item>
+        <shape android:shape="rectangle">
+            <gradient android:angle="315" android:startColor="#FF070D18" android:centerColor="#FF0E1D31" android:endColor="#FF244566" />
+        </shape>
+    </item>
+    <item>
+        <shape android:shape="rectangle">
+            <gradient android:type="radial" android:gradientRadius="900dp" android:centerX="0.12" android:centerY="0.05"
+                android:startColor="#3A8FB8E8" android:endColor="#00000000" />
+        </shape>
+    </item>
+</layer-list>
